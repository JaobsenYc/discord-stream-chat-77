# Discord LFG Bot - 环境变量配置模板(与代码实际读取的变量一一对应)
# 复制此文件为项目根目录的 .env 并填入实际值:cp config/consise.env.example .env

# =============================================================================
# 必需配置
# =============================================================================

# Discord Bot Token(必需)
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord 服务器 ID(必需;开启开发者模式后右键服务器名复制)
GUILD_ID=your_guild_id_here

# 游戏与频道映射(必需;缺失会启动失败)
# 格式: 游戏名:文字频道ID:语音分类ID,多个游戏用英文逗号分隔
# 机器人按「消息发在哪个文字频道」确定游戏,并在对应语音分类下建临时频道
CHANNEL_MAPPINGS=lol:文字频道ID:语音分类ID,Valorant:文字频道ID:语音分类ID

# 找不到匹配映射时的兜底频道/分类
DEFAULT_TEXT_CHANNEL_ID=your_default_text_channel_id
DEFAULT_CATEGORY_ID=your_default_category_id

# =============================================================================
# 数据库与缓存(docker-compose 部署时必需)
# =============================================================================

# Postgres 密码(compose 用它初始化数据库容器;生成: openssl rand -base64 24)
POSTGRES_PASSWORD=your_secure_postgres_password
# Redis 密码
REDIS_PASSWORD=your_secure_redis_password

# 本机直跑(make run)时使用;compose 内的 bot 容器由 compose 自动注入内网地址,无需改这里
# 注意宿主机端口映射为 5433/6380;密码含特殊字符需 URL 编码
DATABASE_URL=postgres://lfguser:your_secure_postgres_password@localhost:5433/lfgbot?sslmode=disable
REDIS_URL=redis://:your_secure_redis_password@localhost:6380

# =============================================================================
# Riot API(可选;不配置则 riotwatch 与 rank 功能自动禁用)
# =============================================================================

# https://developer.riotgames.com/ 获取
RIOT_API_KEY=
# 平台路由(段位/召唤师接口),如 na1 / euw1 / kr
RIOT_REGION=na1
# 区域路由(account/match 接口),如 americas / europe / asia
RIOT_PLATFORM=americas
# 段位排行榜定时发布的频道 ID(可选;不配置则禁用定时发布)
RANK_LEADERBOARD_CHANNEL_ID=
# 职业选手追踪 /trackpro 的专用频道 ID(可选;不配置则任意频道可用,播报发往执行 add 的频道)
PRO_TRACK_CHANNEL_ID=
# 职业选手对局结束时 @ 的身份组 ID(可选;不配置则不 @)
PRO_TRACK_MENTION_ROLE_ID=
# 同时追踪的账号数上限,默认 10(个人/开发 key 每 2 分钟 100 次请求,每个账号每 2 分钟约 6 次)
PRO_TRACK_MAX=10
# 对局状态轮询间隔,默认 20s(最小 5s)
PRO_TRACK_INTERVAL=20s

# =============================================================================
# 机器人行为(全部可选,括号内为默认值)
# =============================================================================

# 文本命令前缀(!)
BOT_PREFIX=!
# 日志级别: debug / info / warn / error(info)
LOG_LEVEL=info
# 健康检查 HTTP 端口(8080)
HEALTH_CHECK_PORT=8080
# 空闲语音频道清理超时(30m)
CHANNEL_CLEANUP_TIMEOUT=30m
# 团队人数上下限(10 / 2)
MAX_TEAM_SIZE=10
MIN_TEAM_SIZE=2

# 管理员用户/频道(逗号分隔的 ID 列表,供 !create-role 等管理命令鉴权)
ADMIN_USER_IDS=
ADMIN_CHANNEL_IDS=

# =============================================================================
# 临时语音房间(可选)
# =============================================================================

TEMP_ROOM_ENABLED=false
# 触发频道:用户加入该语音频道时自动创建专属临时房间
TEMP_ROOM_TRIGGER_CHANNEL=
# 临时房间所在分类
TEMP_ROOM_CATEGORY_ID=
# 房间命名模板,{username} 会被替换为用户名
TEMP_ROOM_NAME_TEMPLATE={username}的房间
# 房间清空后延迟删除时间(如 30s / 5m)
TEMP_ROOM_CLEANUP_DELAY=30s

# =============================================================================
# LOL 内战(可选)
# =============================================================================

LOL_CUSTOM_ENABLED=false
# 内战语音频道所在分类
LOL_CUSTOM_CATEGORY_ID=
# 允许发起内战的文字频道(逗号分隔)
LOL_CUSTOM_CHANNEL_IDS=
# 内战结束后语音频道清理延迟
LOL_CUSTOM_CLEANUP_DELAY=5m

# =============================================================================
# 开发环境专用(生产保持 false)
# =============================================================================

DEVELOPMENT_MODE=false
# 启动时清空监听的文字频道消息 / 语音频道(危险,仅测试服使用)
CLEANUP_TEXT_CHANNELS_ON_START=false
CLEANUP_VOICE_CHANNELS_ON_START=false
